@page "/"
@attribute [Authorize]
@inject NavigationManager Nav

<PageTitle>HelpDesk</PageTitle>

<p class="m-4">Carregando...</p>

@code {
    [CascadingParameter] private Task<AuthenticationState> EstadoAutenticacao { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var estado = await EstadoAutenticacao;
        var ehAtendente = estado.User.IsInRole("Atendente") || estado.User.IsInRole("Admin");

        // Atendente/admin caem no dashboard; cliente cai direto na lista de chamados.
        Nav.NavigateTo(ehAtendente ? "dashboard" : "chamados", replace: true);
    }
}
