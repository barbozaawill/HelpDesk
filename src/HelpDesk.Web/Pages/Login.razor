@page "/login"
@using System.ComponentModel.DataAnnotations
@inject ServicoDeSessao Sessao
@inject NavigationManager Nav

<PageTitle>Entrar - HelpDesk</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-5">
        <h1 class="h3 my-4">Entrar</h1>

        <EditForm Model="modelo" OnValidSubmit="Entrar">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label">E-mail</label>
                <InputText class="form-control" @bind-Value="modelo.Email" autocomplete="username" />
                <ValidationMessage For="() => modelo.Email" class="text-danger small" />
            </div>

            <div class="mb-3">
                <label class="form-label">Senha</label>
                <InputText type="password" class="form-control" @bind-Value="modelo.Senha" autocomplete="current-password" />
                <ValidationMessage For="() => modelo.Senha" class="text-danger small" />
            </div>

            @if (erro is not null)
            {
                <div class="alert alert-danger py-2">@erro</div>
            }

            <button type="submit" class="btn btn-primary w-100" disabled="@ocupado">
                @(ocupado ? "Entrando..." : "Entrar")
            </button>
        </EditForm>

        <p class="mt-3 small">Nao tem conta? <a href="registrar">Criar conta de cliente</a></p>

        <div class="alert alert-secondary small mt-4">
            <strong>Usuarios de teste (seed):</strong>
            <ul class="mb-0">
                <li>admin@helpdesk.local / Admin@123</li>
                <li>ana@helpdesk.local / Atende@123 (atendente)</li>
                <li>carlos@cliente.local / Cliente@123 (cliente)</li>
            </ul>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] private string? Retorno { get; set; }

    private readonly Credenciais modelo = new();
    private string? erro;
    private bool ocupado;

    private async Task Entrar()
    {
        ocupado = true;
        erro = null;
        try
        {
            await Sessao.EntrarAsync(modelo.Email, modelo.Senha);
            Nav.NavigateTo(string.IsNullOrWhiteSpace(Retorno) ? "" : Retorno);
        }
        catch (ApiException ex)
        {
            erro = ex.Message;
        }
        finally
        {
            ocupado = false;
        }
    }

    private class Credenciais
    {
        [Required(ErrorMessage = "Informe o e-mail")]
        [EmailAddress(ErrorMessage = "E-mail invalido")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Informe a senha")]
        public string Senha { get; set; } = string.Empty;
    }
}
