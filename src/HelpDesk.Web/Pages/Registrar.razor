@page "/registrar"
@using System.ComponentModel.DataAnnotations
@inject ServicoDeSessao Sessao
@inject NavigationManager Nav

<PageTitle>Criar conta - HelpDesk</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-5">
        <h1 class="h3 my-4">Criar conta de cliente</h1>

        <EditForm Model="modelo" OnValidSubmit="Cadastrar">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label">Nome</label>
                <InputText class="form-control" @bind-Value="modelo.Nome" />
                <ValidationMessage For="() => modelo.Nome" class="text-danger small" />
            </div>

            <div class="mb-3">
                <label class="form-label">E-mail</label>
                <InputText class="form-control" @bind-Value="modelo.Email" />
                <ValidationMessage For="() => modelo.Email" class="text-danger small" />
            </div>

            <div class="mb-3">
                <label class="form-label">Senha (min. 6 caracteres)</label>
                <InputText type="password" class="form-control" @bind-Value="modelo.Senha" />
                <ValidationMessage For="() => modelo.Senha" class="text-danger small" />
            </div>

            @if (erro is not null)
            {
                <div class="alert alert-danger py-2">@erro</div>
            }

            <button type="submit" class="btn btn-primary w-100" disabled="@ocupado">
                @(ocupado ? "Criando..." : "Criar conta")
            </button>
        </EditForm>

        <p class="mt-3 small">Ja tem conta? <a href="login">Entrar</a></p>
    </div>
</div>

@code {
    private readonly Dados modelo = new();
    private string? erro;
    private bool ocupado;

    private async Task Cadastrar()
    {
        ocupado = true;
        erro = null;
        try
        {
            await Sessao.CadastrarAsync(modelo.Nome, modelo.Email, modelo.Senha);
            Nav.NavigateTo("");
        }
        catch (ApiException ex)
        {
            erro = ex.Message;
        }
        finally
        {
            ocupado = false;
        }
    }

    private class Dados
    {
        [Required(ErrorMessage = "Informe seu nome")]
        [MinLength(2, ErrorMessage = "Nome muito curto")]
        public string Nome { get; set; } = string.Empty;

        [Required(ErrorMessage = "Informe o e-mail")]
        [EmailAddress(ErrorMessage = "E-mail invalido")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Informe a senha")]
        [MinLength(6, ErrorMessage = "Minimo de 6 caracteres")]
        public string Senha { get; set; } = string.Empty;
    }
}
